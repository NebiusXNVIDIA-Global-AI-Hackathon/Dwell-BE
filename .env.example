# Copy to .env (cp .env.example .env) - never commit .env
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000
DOCKERHUB_USERNAME=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=dwell-s3
# Nebius Token Factory key for the Deaver assistant (chat returns 503 without it)
NEBIUS_API_KEY=
# Optional (defaults in application.yml)
# SLA_CHECK_ENABLED=true
# SLA_CHECK_INTERVAL=PT5M
# NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_JUDGE_MODEL= (case severity judge; defaults to NEBIUS_MODEL)
# Tuned Gemini for evidence photos/videos (case severity is photo-less Inconclusive without it)
# GEMINI_ENDPOINT_URL=https://aiplatform.us.rep.googleapis.com/v1/projects/{project}/locations/us/endpoints/{endpointId}:generateContent
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json (Vertex AI User role)
# JWT_ACCESS_EXPIRATION=3600000
# JWT_REFRESH_EXPIRATION=1209600000
# Demo time shift API (POST /api/v1/admin/demo/...) - set true only on the demo server
DEMO_TIME_SHIFT_ENABLED=false
