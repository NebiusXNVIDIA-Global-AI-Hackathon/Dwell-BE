# Copy to .env (cp .env.example .env) - never commit .env
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000
DOCKERHUB_USERNAME=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=dwell-s3
# Optional (defaults in application.yml)
# SLA_CHECK_ENABLED=true
# SLA_CHECK_INTERVAL=PT5M
# Demo time shift API (POST /api/v1/admin/demo/...) - set true only on the demo server
DEMO_TIME_SHIFT_ENABLED=false
